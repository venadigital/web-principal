# ──────────────────────────────────────────────────────────────
# Vena Digital — variables de entorno
# Copia este archivo a .env y completa los valores
# ──────────────────────────────────────────────────────────────

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Correo donde llegan los leads del formulario
LEAD_TO_EMAIL=laura@venadigital.com.co

# Remitente (debe ser un dominio verificado en Resend)
LEAD_FROM_EMAIL=Vena Digital <contacto@venadigital.com.co>

# Puerto (Hostinger normalmente asigna uno vía process.env.PORT)
PORT=3000
